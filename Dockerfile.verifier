ARG OPENSHELL_BASE_IMAGE=ghcr.io/nvidia/openshell-community/sandboxes/base:latest
FROM ${OPENSHELL_BASE_IMAGE}

LABEL org.opencontainers.image.source="https://github.com/ed3c/XT-Aegis"
LABEL org.opencontainers.image.description="XT-Aegis local MCP verifier and bounded verification runtime"
LABEL org.opencontainers.image.licenses="MIT"
LABEL io.modelcontextprotocol.server.name="io.github.ed3c/xt-aegis-verifier"

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

USER root
WORKDIR /opt/xt-aegis
COPY LICENSE README.md pyproject.toml ./
COPY src ./src
RUN /sandbox/.venv/bin/python -m pip install ".[dev,mcp]" \
    && install -d -o sandbox -g sandbox /workspace

USER sandbox
WORKDIR /sandbox

CMD ["xt-aegis-mcp"]
