{
  "$schema": "verification/schemas/evidence-registry.schema.json",
  "schema_version": "2.0",
  "project": "XT-Aegis",
  "version": "0.2.0",
  "maturity": "alpha reference implementation",
  "license": "MIT",
  "repository": "https://github.com/ed3c/XT-Aegis",
  "verification_contract": {
    "executable_allowlist": [
      "python",
      "python3",
      "pytest",
      "ruff",
      "mypy"
    ],
    "default_backend": "auto",
    "strong_backends": [
      "openshell",
      "podman",
      "docker"
    ],
    "unsafe_local_requires_explicit_opt_in": true,
    "environment_allowlist": []
  },
  "claims": [
    {
      "id": "skill-frontmatter-only",
      "claim": "Only validated YAML front matter affects execution; Markdown prose and fenced code blocks remain inert.",
      "status": "implemented",
      "evidence": [
        "src/xt_aegis/skill.py",
        "tests/test_skill.py",
        "src/xt_aegis/demo_assets/refactor.SKILL.md"
      ],
      "verification": {
        "argv": [
          "python",
          "-m",
          "pytest",
          "tests/test_skill.py",
          "-q"
        ],
        "cwd": ".",
        "timeout_seconds": 120,
        "expected_exit_codes": [
          0
        ],
        "network": "deny",
        "max_output_bytes": 1048576,
        "artifacts": []
      },
      "expected": {
        "status": "verified",
        "assertions": {}
      },
      "limitations": [
        "The skill author remains trusted to define safe structured preconditions and postconditions."
      ]
    },
    {
      "id": "external-content-boundary",
      "claim": "An action labeled as external content is rejected before a side effect occurs.",
      "status": "implemented",
      "evidence": [
        "src/xt_aegis/models.py",
        "src/xt_aegis/policy.py",
        "tests/test_policy.py",
        "tests/test_runner.py"
      ],
      "verification": {
        "argv": [
          "python",
          "-m",
          "pytest",
          "tests/test_policy.py",
          "tests/test_runner.py",
          "-k",
          "external",
          "-q"
        ],
        "cwd": ".",
        "timeout_seconds": 120,
        "expected_exit_codes": [
          0
        ],
        "network": "deny",
        "max_output_bytes": 1048576,
        "artifacts": []
      },
      "expected": {
        "status": "verified",
        "assertions": {}
      },
      "limitations": [
        "Correct provenance labeling must be enforced by the integration that creates ActionRequest objects."
      ]
    },
    {
      "id": "argv-no-shell",
      "claim": "Command actions use argv arrays with shell=False and apply executable, argument, working-directory, and network policy checks.",
      "status": "implemented",
      "evidence": [
        "src/xt_aegis/policy.py",
        "src/xt_aegis/runner.py",
        "tests/test_policy.py"
      ],
      "verification": {
        "argv": [
          "python",
          "-m",
          "pytest",
          "tests/test_policy.py",
          "-q"
        ],
        "cwd": ".",
        "timeout_seconds": 120,
        "expected_exit_codes": [
          0
        ],
        "network": "deny",
        "max_output_bytes": 1048576,
        "artifacts": []
      },
      "expected": {
        "status": "verified",
        "assertions": {}
      },
      "limitations": [
        "An allowlisted interpreter or test suite can still perform behavior not visible from its executable name."
      ]
    },
    {
      "id": "declared-command-exit-contract",
      "claim": "Command actions, preconditions, and postconditions use the declared expected exit-code set; undeclared codes, timeouts, signals, and failed assertions remain failures.",
      "status": "implemented",
      "evidence": [
        "src/xt_aegis/models.py",
        "src/xt_aegis/runner.py",
        "tests/test_runner.py",
        "docs/ARCHITECTURE.md"
      ],
      "verification": {
        "argv": [
          "python",
          "-m",
          "pytest",
          "tests/test_runner.py",
          "-k",
          "command_action or command_timeout or signal_termination or postcondition_failure or expected_exit_codes",
          "-q"
        ],
        "cwd": ".",
        "timeout_seconds": 180,
        "expected_exit_codes": [
          0
        ],
        "network": "deny",
        "max_output_bytes": 1048576,
        "artifacts": []
      },
      "expected": {
        "status": "verified",
        "assertions": {}
      },
      "limitations": [
        "A declared exit code is an outcome contract, not proof of semantic correctness; postconditions and isolation remain required.",
        "Portable declared process exits are restricted to integers from 0 through 255; signal return codes are never declarable."
      ]
    },
    {
      "id": "path-confined-write",
      "claim": "File writes are relative, allowlisted, size-bounded, path-confined, and atomic.",
      "status": "implemented",
      "evidence": [
        "src/xt_aegis/policy.py",
        "src/xt_aegis/workspace.py",
        "src/xt_aegis/runner.py",
        "tests/test_policy.py"
      ],
      "verification": {
        "argv": [
          "python",
          "-m",
          "pytest",
          "tests/test_policy.py",
          "-q"
        ],
        "cwd": ".",
        "timeout_seconds": 120,
        "expected_exit_codes": [
          0
        ],
        "network": "deny",
        "max_output_bytes": 1048576,
        "artifacts": []
      },
      "expected": {
        "status": "verified",
        "assertions": {}
      },
      "limitations": [
        "The local snapshot backend does not provide an OS-level read-only filesystem outside the workspace."
      ]
    },
    {
      "id": "transactional-rollback",
      "claim": "A failed mutation restores the owned workspace snapshot and records a before/after tree hash.",
      "status": "implemented",
      "evidence": [
        "src/xt_aegis/workspace.py",
        "src/xt_aegis/runner.py",
        "tests/test_runner.py"
      ],
      "verification": {
        "argv": [
          "python",
          "-m",
          "pytest",
          "tests/test_runner.py",
          "-k",
          "rolled_back",
          "-q"
        ],
        "cwd": ".",
        "timeout_seconds": 120,
        "expected_exit_codes": [
          0
        ],
        "network": "deny",
        "max_output_bytes": 1048576,
        "artifacts": []
      },
      "expected": {
        "status": "verified",
        "assertions": {}
      },
      "limitations": [
        "Snapshot copying targets small local workspaces; copy-on-write and container backends remain separate concerns."
      ]
    },
    {
      "id": "durable-checkpoint-idempotency",
      "claim": "SQLite WAL persists runs, steps, approvals, events, and resume position while binding every idempotency key to one versioned canonical request and policy identity before replay.",
      "status": "implemented",
      "evidence": [
        "src/xt_aegis/identity.py",
        "src/xt_aegis/checkpoint.py",
        "src/xt_aegis/runner.py",
        "tests/test_identity.py",
        "tests/test_checkpoint.py",
        "tests/test_runner.py"
      ],
      "verification": {
        "argv": [
          "python",
          "-m",
          "pytest",
          "tests/test_identity.py",
          "tests/test_checkpoint.py",
          "tests/test_runner.py",
          "-k",
          "identity or idempot or resume or legacy or checkpoint_schema",
          "-q"
        ],
        "cwd": ".",
        "timeout_seconds": 180,
        "expected_exit_codes": [
          0
        ],
        "network": "deny",
        "max_output_bytes": 1048576,
        "artifacts": []
      },
      "expected": {
        "status": "verified",
        "assertions": {}
      },
      "limitations": [
        "SQLite is a single-node backend; distributed leases and fencing tokens are not implemented.",
        "Canonical digests provide integrity binding, not authenticated identity.",
        "Legacy rows without digest fields fail closed and cannot replay a result."
      ]
    },
    {
      "id": "human-approval",
      "claim": "High-risk actions suspend until an unexpired, single-use approval bound to the exact canonical request, policy, and optional actor label is granted.",
      "status": "implemented",
      "evidence": [
        "src/xt_aegis/identity.py",
        "src/xt_aegis/checkpoint.py",
        "src/xt_aegis/runner.py",
        "tests/test_checkpoint.py",
        "tests/test_runner.py"
      ],
      "verification": {
        "argv": [
          "python",
          "-m",
          "pytest",
          "tests/test_checkpoint.py",
          "tests/test_runner.py",
          "-k",
          "approval",
          "-q"
        ],
        "cwd": ".",
        "timeout_seconds": 120,
        "expected_exit_codes": [
          0
        ],
        "network": "deny",
        "max_output_bytes": 1048576,
        "artifacts": []
      },
      "expected": {
        "status": "verified",
        "assertions": {}
      },
      "limitations": [
        "The local runtime has no external identity provider or cryptographic approver authentication.",
        "A crash after approval consumption fails closed and requires a fresh approval before retry."
      ]
    },
    {
      "id": "trajectory-evaluation",
      "claim": "Outcome, rollback integrity, prompt-injection blocking, and attempt efficiency are scored from deterministic records.",
      "status": "implemented",
      "evidence": [
        "src/xt_aegis/evaluator.py",
        "tests/test_evaluator.py"
