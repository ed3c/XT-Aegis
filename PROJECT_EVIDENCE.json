      "expected": {
        "status": "verified",
        "assertions": {}
      },
      "limitations": [
        "Scores are task-specific rules, not a universal measure of agent quality."
      ]
    },
    {
      "id": "external-verification-contract",
      "claim": "Claims are expressed as strictly validated argv-only recipes with bounded time, output, paths, and default-deny networking.",
      "status": "implemented",
      "evidence": [
